# =============================================================================
# LLM Configuration for gepa_standalone
# =============================================================================

# Default connection. It belongs to the provider of LLM_MODEL_TASK (anchor
# provider): roles of the same provider inherit it, roles of another provider
# do NOT (see "Per-role connection" below and docs/LLM_CONFIG.md).
LLM_API_KEY=your-api-key-here

# Azure OpenAI endpoint (required for Azure, leave empty for OpenAI direct)
LLM_API_BASE=https://your-resource.openai.azure.com
LLM_API_VERSION=2024-02-15-preview

# Models (format: provider/model). LLM_MODEL_TASK and LLM_MODEL_REFLECTION are
# required: there is no default and a missing one stops the run at startup.
# Task model: fast and cheap for inference
LLM_MODEL_TASK=azure/gpt-4.1-mini

# Reflection model: powerful for GEPA optimization
LLM_MODEL_REFLECTION=azure/gpt-4o

# =============================================================================
# Alternative: OpenAI Direct
# =============================================================================
# LLM_API_KEY=sk-your-openai-key
# LLM_API_BASE=
# LLM_MODEL_TASK=openai/gpt-4o-mini
# LLM_MODEL_REFLECTION=openai/gpt-4o


# =============================================================================
# Alternative: Anthropic (SPEC-103)
# =============================================================================
# Format: anthropic/<id>. Supported IDs and per-model constraints: docs/LLM_CONFIG.md
# LLM_API_VERSION is not sent. A global LLM_API_BASE is not sent either (it is
# ignored with a warning): leave it empty. For a proxy or gateway use
# LLM_API_BASE_<ROLE>, which is sent as is.
# LLM_API_KEY=sk-ant-your-anthropic-key
# LLM_API_BASE=
# LLM_MODEL_TASK=anthropic/claude-haiku-5-5
# LLM_MODEL_REFLECTION=anthropic/claude-sonnet-5-5
#
# Optional, per role (TASK, REFLECTION, JUDGE). Empty = not configured.
# Effort: low | medium | high | xhigh | max (accepted values depend on the model)
# LLM_EFFORT_TASK=medium
# LLM_EFFORT_REFLECTION=high
# Thinking: default (sends nothing) | off (turns reasoning off where allowed)
# LLM_THINKING_TASK=off
# LLM_THINKING_REFLECTION=default

# =============================================================================
# Per-role connection (SPEC-106): e.g. Azure student + Claude teacher
# =============================================================================
# The global LLM_API_KEY/LLM_API_BASE/LLM_API_VERSION above belong to the
# provider of LLM_MODEL_TASK. A role of a different provider never inherits them:
# it MUST define its own key, or startup fails naming the role and the variable.
# Variables per role (ROLE = TASK, REFLECTION, JUDGE): LLM_API_KEY_<ROLE>,
# LLM_API_BASE_<ROLE>, LLM_API_VERSION_<ROLE>. Empty = not defined.
# LLM_MODEL_TASK=azure/gpt-4.1-mini
# LLM_MODEL_REFLECTION=anthropic/claude-sonnet-5-5
# LLM_API_KEY_REFLECTION=sk-ant-your-anthropic-key
# LLM_API_BASE_REFLECTION=            # only for a proxy/gateway

# Judge (RAG adapter only). Without LLM_MODEL_JUDGE the judge uses the teacher's
# resolved configuration and any LLM_*_JUDGE variable is ignored with a warning.
# With it, the judge is one more role (own connection, effort and thinking).
# LLM_MODEL_JUDGE=anthropic/claude-sonnet-5-5
# LLM_API_KEY_JUDGE=sk-ant-your-anthropic-key
# LLM_EFFORT_JUDGE=medium
# LLM_THINKING_JUDGE=default

# Extra .env to load when no credential is defined (neither LLM_API_KEY nor any
# LLM_API_KEY_<ROLE>).
# LLM_ENV_FILE=/path/to/other.env
